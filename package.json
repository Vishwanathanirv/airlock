{
  "name": "airlock",
  "private": true,
  "version": "1.0.0",
  "description": "Airlock: a firewall for LLM apps. Stops prompt injection (direct, hidden and indirect), redacts secrets and personal data, and catches system-prompt leaks and data exfiltration in model output.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "train": "tsx scripts/train.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "bench": "tsx scripts/bench.ts",
    "tune": "tsx scripts/tune.ts",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev -w apps/api\" \"npm:dev -w apps/web\"",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "start": "node apps/api/dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p apps/api && tsc -p apps/web",
    "lint": "eslint .",
    "build:demo": "npm run build:demo -w apps/web",
    "test:e2e": "npm run build:demo && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
