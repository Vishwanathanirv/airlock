# Where to forward chat requests (any OpenAI-compatible API). Leave empty to use the built-in demo bot.
UPSTREAM_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=
# Keys your apps send to Airlock as "Authorization: Bearer <key>". Comma separated. Required in production.
AIRLOCK_KEYS=
# Token for changing the policy from the dashboard (sent as x-admin-token).
ADMIN_TOKEN=
PORT=8080
